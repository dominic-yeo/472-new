            "mimeType": "application/json",
            "compression": 0,
            "text": "{\n  \"title\": \"Bienvenido al servidor {{name}}\",\n  \"desc\": \"Aquí tienes algunos pasos para ayudarte a comenzar.\",\n  \"invite\": \"Invita a tus amigos o compañeros de equipo\",\n  \"start_by_channel\": \"Crea un Canal para Iniciar una Conversación\",\n  \"start_by_dm\": \"Envía un Mensaje Directo\",\n  \"download\": \"Descarga las aplicaciones móviles\",\n  \"help\": \"¿Tienes preguntas? Visita nuestro centro de ayuda\",\n  \"sign_in_tip\": \"Por favor, inicia sesión para enviar mensajes\",\n  \"vocespace\": \"Llamada de video VoceSpace\",\n  \"license\": \"VoceChat Licencia de Actualización\",\n  \"page_editor\": {\n    \"title\": \"Page Management\",\n    \"status_select\": \"Select State\",\n    \"signed_in\": \"Signed In\",\n    \"not_signed_in\": \"Visitors\",\n    \"signed_in_users\": \"Signed-in Users\",\n    \"not_signed_in_users\": \"Visitors\",\n    \"current_state\": \"Current State:\",\n    \"save\": \"Save Changes\",\n    \"saving\": \"Saving…\",\n    \"live_preview\": \"Live Preview\",\n    \"download_html\": \"Download Page HTML\",\n    \"upload_html\": \"Upload Custom HTML Page\",\n    \"uploading\": \"Uploading…\",\n    \"reset\": \"Reset to Default\",\n    \"resetting\": \"Resetting…\",\n    \"ai_tip\": \"Want to use an AI agent to automatically write your homepage?\",\n    \"copy_prompt\": \"Copy Prompt\",\n    \"copied\": \"Copied!\",\n    \"html_preview\": \"Current Active HTML Preview\",\n    \"loading\": \"Loading…\"\n  },\n  \"onboarding\": {\n    \"title\": \"Configuración de VoceChat\",\n    \"welcome\": \"¡Bienvenido a tu VoceChat!\",\n    \"welcome_desc\": \"Todo en este espacio te pertenece. ¡Vamos a configurar tu espacio!\",\n    \"start\": \"Comenzar\",\n    \"new_server\": \"Nombrar tu nuevo servidor\",\n    \"server_desc\": \"Los servidores son entornos compartidos donde los equipos pueden trabajar en proyectos y chatear.\",\n    \"placeholder_server\": \"Ingresa el nombre del servidor\",\n    \"create_server\": \"Crear Servidor\",\n    \"admin_title\": \"Ahora configuremos tu cuenta de administrador\",\n    \"admin_desc\": \"¡Eres el primer usuario y administrador de tu espacio!\",\n    \"sign\": \"Registrarse\",\n    \"invite_title\": \"Último paso: ¡invita a otros!\",\n    \"invite_desc\": \"Primero, ¿quién puede registrarse en este servidor?\",\n    \"confirm\": \"Confirmar\",\n    \"done_welcome\": \"Bienvenido a {{serverName}}\",\n    \"done_title\": \"Orgullosamente presentado por VoceChat\",\n    \"done_desc\": \"Más ajustes, incluyendo resolución de dominio, privilegios, seguridad e invitaciones están disponibles en <0>Configuración</0>\",\n    \"enter\": \"Entrar\",\n    \"last_tip\": \"¡Ahora invita a otros!\",\n    \"last_desc\": \"Envía el enlace de invitación a los futuros miembros de tu comunidad:\",\n    \"done\": \"Hecho\",\n    \"welcome_page\": \"Página de Bienvenida\",\n    \"set_name\": \"Configurar Nombre\",\n    \"admin_account\": \"Cuenta de Administrador\",\n    \"who_sign_up\": \"Quién Puede Registrarse\",\n    \"invites\": \"Invitaciones\",\n    \"update_domain_tip\": \"¿Enlace de dominio incorrecto? Actualízalo aquí:\",\n    \"tunnel_initializing\": \"Initializing Tunnel service...\",\n    \"tunnel_dns_warning\": \"Waiting for DNS propagation. If access fails, try clearing your DNS cache and retrying.\",\n    \"tunnel_redirect_countdown\": \"Redirecting to public address in {{seconds}}s...\",\n    \"tunnel_domain_assigned\": \"A public domain has been assigned to you\",\n    \"tunnel_opt_in_title\": \"Get an automatically assigned public domain?\",\n    \"tunnel_opt_in_yes\": \"Yes\",\n    \"tunnel_opt_in_skip\": \"Next\",\n    \"tunnel_progress\": \"Starting tunnel...\",\n    \"tunnel_error\": \"Tunnel error\",\n    \"tunnel_get_domain\": \"Get Public Domain\"\n  }\n}\n"
