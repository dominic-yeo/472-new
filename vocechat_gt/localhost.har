            "text": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>chat-reborn</title>\n  <style>\n    :root {\n      --bg-color: #343946;\n      --card-bg: #222631;\n      --card-hover: #1b1e27;\n      --text-main: #ffffff;\n      --text-sub: #9499a6;\n      --icon-yellow: #fcd34d;\n      --icon-purple: #a78bfa;\n      --icon-teal: #2dd4bf;\n      --icon-green: #86efac;\n    }\n\n    @media (prefers-color-scheme: light) {\n      :root {\n        --bg-color: #f3f4f6;\n        --card-bg: #ffffff;\n        --card-hover: #f9fafb;\n        --text-main: #1f2937;\n        --text-sub: #6b7280;\n        --icon-yellow: #f59e0b;\n        --icon-purple: #8b5cf6;\n        --icon-teal: #0d9488;\n        --icon-green: #10b981;\n      }\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      background-color: var(--bg-color);\n      color: var(--text-main);\n      min-height: 100vh;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      transition: background-color 0.2s ease;\n    }\n\n    .container {\n      width: 100%;\n      max-width: 520px;\n      padding: 40px 20px;\n      text-align: center;\n    }\n\n    .header {\n      margin-bottom: 36px;\n    }\n\n    .header h1 {\n      font-size: 2rem;\n      font-weight: 700;\n      letter-spacing: -0.5px;\n      margin-bottom: 8px;\n    }\n\n    .header p {\n      color: var(--text-sub);\n      font-size: 0.9rem;\n      font-weight: 400;\n    }\n\n    .grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 20px;\n    }\n\n    .card {\n      background-color: var(--card-bg);\n      border-radius: 28px;\n      padding: 32px 16px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      cursor: pointer;\n      transition: background-color 0.15s ease, transform 0.15s ease;\n      border: none;\n      outline: none;\n      aspect-ratio: 1 / 1;\n      width: 100%;\n    }\n\n    .card:hover {\n      background-color: var(--card-hover);\n      transform: translateY(-2px);\n    }\n\n    .card:active {\n      transform: translateY(0);\n    }\n\n    .icon-wrapper {\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      margin-bottom: 24px;\n      color: #ffffff;\n    }\n\n    .card-text {\n      font-size: 0.95rem;\n      font-weight: 600;\n      color: var(--text-main);\n      line-height: 1.4;\n      text-align: center;\n      max-width: 160px;\n    }\n\n    .icon-yellow { background-color: var(--icon-yellow); }\n    .icon-purple { background-color: var(--icon-purple); }\n    .icon-teal { background-color: var(--icon-teal); }\n    .icon-green { background-color: var(--icon-green); }\n\n    svg {\n      width: 24px;\n      height: 24px;\n      fill: currentColor;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1 id=\"title\">欢迎来到 chat</h1>\n      <p id=\"subtitle\">下面几步，有助于您开始</p>\n    </div>\n\n    <div class=\"grid\">\n      <button class=\"card\" id=\"btn-invite\">\n        <div class=\"icon-wrapper icon-yellow\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 2 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"/>\n          </svg>\n        </div>\n        <div class=\"card-text\" id=\"label-invite\">邀请朋友或队友</div>\n      </button>\n\n      <button class=\"card\" id=\"btn-channel\">\n        <div class=\"icon-wrapper icon-purple\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12l-3-2.25V13c0 .55-.45 1-1 1H7c-.55 0-1-.45-1-1V9c0-.55.45-1 1-1h7c.55 0 1 .45 1 1v1.25L18 8v6z\"/>\n          </svg>\n        </div>\n        <div class=\"card-text\" id=\"label-channel\">创建频道，开启会话</div>\n      </button>\n\n      <button class=\"card\" id=\"btn-dm\">\n        <div class=\"icon-wrapper icon-teal\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"6\" r=\"2.5\"/>\n            <circle cx=\"6\" cy=\"8.5\" r=\"2\"/>\n            <circle cx=\"18\" cy=\"8.5\" r=\"2\"/>\n            <path d=\"M12 10c-2.7 0-5 1.5-6 3.5.8.5 1.8.8 2.8.8.8 0 1.6-.2 2.3-.5.3-.1.6-.2.9-.2s.6.1.9.2c.7.3 1.5.5 2.3.5 1 0 2-.3 2.8-.8-1-2-3.3-3.5-6-3.5z\"/>\n            <path d=\"M6 11.5c-1.8 0-3.3.9-4 2.2.5.4 1.1.7 1.8.7.6 0 1.2-.2 1.7-.4.5-.2 1-.3 1.5-.3s1 .1 1.5.3c.5.2 1.1.4 1.7.4.7 0 1.3-.3 1.8-.7-.7-1.3-2.2-2.2-4-2.2z\"/>\n            <path d=\"M18 11.5c-1.8 0-3.3.9-4 2.2.5.4 1.1.7 1.8.7.6 0 1.2-.2 1.7-.4.5-.2 1-.3 1.5-.3s1 .1 1.5.3c.5.2 1.1.4 1.7.4.7 0 1.3-.3 1.8-.7-.7-1.3-2.2-2.2-4-2.2z\"/>\n          </svg>\n        </div>\n        <div class=\"card-text\" id=\"label-dm\">VoceSpace 视频通话</div>\n      </button>\n\n      <button class=\"card\" id=\"btn-help\">\n        <div class=\"icon-wrapper icon-green\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16h-2v-2h2v2zm1.07-7.75l-.9.92C12.45 11.9 12 12.5 12 14h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z\"/>\n          </svg>\n        </div>\n        <div class=\"card-text\" id=\"label-help\">还有问题？访问我们的帮助中心</div>\n      </button>\n    </div>\n  </div>\n\n  <script>\n    const i18n = {\n      zh: {\n        title: \"欢迎来到 {server_name}\",\n        subtitle: \"下面几步，有助于您开始\",\n        invite: \"邀请朋友或队友\",\n        channel: \"创建频道，开启会话\",\n        dm: \"VoceSpace 视频通话\",\n        help: \"还有问题？访问我们的帮助中心\"\n      },\n      en: {\n        title: \"Welcome to {server_name}\",\n        subtitle: \"Here are a few steps to help you get started\",\n        invite: \"Invite friends or teammates\",\n        channel: \"Create channel, start conversation\",\n        dm: \"VoceSpace Video Call\",\n        help: \"Still have questions? Visit our Help Center\"\n      }\n    };\n\n    const userLang = navigator.language.startsWith('zh') ? 'zh' : 'en';\n    let currentLang = userLang;\n    let serverName = \"chat\";\n    let chatAction = \"create_channel\";\n\n    function updateTexts() {\n      const dict = i18n[currentLang];\n      document.getElementById('title').textContent = dict.title.replace('{server_name}', serverName);\n      document.getElementById('subtitle').textContent = dict.subtitle;\n      document.getElementById('label-invite').textContent = dict.invite;\n      document.getElementById('label-channel').textContent = dict.channel;\n      document.getElementById('label-dm').textContent = dict.dm;\n      document.getElementById('label-help').textContent = dict.help;\n    }\n\n    function sendAction(actionName) {\n      if (window.parent) {\n        window.parent.postMessage({ type: \"action\", action: actionName }, \"*\");\n      }\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", () => {\n      updateTexts();\n\n      if (window.parent) {\n        window.parent.postMessage({ type: \"iframe_ready\", page: \"signed_in\" }, \"*\");\n      }\n\n      document.getElementById('btn-invite').addEventListener('click', () => sendAction('invite'));\n      document.getElementById('btn-channel').addEventListener('click', () => sendAction(chatAction));\n      document.getElementById('btn-dm').addEventListener('click', () => sendAction('start_dm'));\n      document.getElementById('btn-help').addEventListener('click', () => {\n        window.open('https://doc.voce.chat/', '_blank');\n      });\n    });\n\n    window.addEventListener(\"message\", (event) => {\n      const data = event.data;\n      if (data && data.type === \"server_info\") {\n        if (data.name) {\n          serverName = data.name;\n        }\n        if (data.chatAction) {\n          chatAction = data.chatAction;\n        }\n\n        const inviteBtn = document.getElementById('btn-invite');\n        if (data.canInvite === false) {\n          inviteBtn.style.opacity = \"0.5\";\n          inviteBtn.style.pointerEvents = \"none\";\n        } else {\n          inviteBtn.style.opacity = \"1\";\n          inviteBtn.style.pointerEvents = \"auto\";\n        }\n\n        if (data.labels) {\n          if (data.labels.invite) document.getElementById('label-invite').textContent = data.labels.invite;\n          if (data.labels.channel) document.getElementById('label-channel').textContent = data.labels.channel;\n          if (data.labels.help) document.getElementById('label-help').textContent = data.labels.help;\n        }\n\n        const dict = i18n[currentLang];\n        document.getElementById('title').textContent = dict.title.replace('{server_name}', serverName);\n      }\n    });\n  </script>\n</body>\n</html>"
          },
