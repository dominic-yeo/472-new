          "content": {
            "size": 17048,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\n  \"title\": \"Configuración\",\n  \"save_change\": \"Guardar Cambios\",\n  \"reset\": \"Restablecer\",\n  \"save_tip\": \"¡Tienes cambios no guardados!\",\n  \"nav\": {\n    \"general\": \"General\",\n    \"overview\": \"Visión General\",\n    \"members\": \"Miembros\",\n    \"data_management\": \"Gestión de Datos\",\n    \"auto_delete_msg\": \"Eliminar Mensajes Automáticamente\",\n    \"user\": \"Usuario\",\n    \"my_account\": \"Mi Cuenta\",\n    \"config\": \"Configuración\",\n    \"bot\": \"Bot & Webhook\",\n    \"notification_channels\": \"Canales de Notificación\",\n    \"firebase\": \"Firebase\",\n    \"agora\": \"Agora\",\n    \"smtp\": \"SMTP\",\n    \"login_method\": \"Métodos de Inicio de Sesión\",\n    \"third_app\": \"Inicio de Sesión de Terceros\",\n    \"widget\": \"Widget\",\n    \"license\": \"Licencia\",\n    \"about\": \"Acerca de\",\n    \"api_doc\": \"Documentación de API\",\n    \"version\": \"Versión\",\n    \"video\": \"Video\",\n    \"notification\": \"Notificaciones\"\n  },\n  \"vocespace\": {\n    \"add\": \"Agregar\",\n    \"check\": \"Comprobar\",\n    \"checked\": \"Aprobado\",\n    \"failed\": \"Fallido\",\n    \"title\": \"VoceSpace\",\n    \"desc\": \"VoceSpace implementado de forma privada (implementación automática)\",\n    \"sub_desc\": \"Cada cuenta de VoceSpace disfrutará de llamadas ilimitadas gratuitas, 5 usuarios simultáneos y resolución 4K. No es necesario crear una cuenta. Siga las instrucciones a continuación para configurar correctamente su VoceSpace.\",\n    \"prerequisite\": [\n      \"Prerrequisitos\",\n      \"Entorno Docker\",\n      \"Puertos 80, 443, 7880, 7881, 3008 y 3000 abiertos\",\n      \"Nombre de dominio que resuelve a la dirección IP local (para usuarios en China continental, como Alibaba Cloud y Tencent Cloud, se requiere el registro ICP)\",\n      \"Para personalización empresarial o asistencia, contacte con han@privoce.com o agregue WeChat: Privoce\"\n    ],\n    \"domain_desc\": \"Los nombres de dominio personalizados deben resolver a la dirección IP local (para usuarios en China continental, como Alibaba Cloud y Tencent Cloud, se requiere el registro ICP)\",\n    \"enable\": \"Habilitar\",\n    \"how_to\": \"Después de habilitar, configure el nombre de dominio y guarde. Los pasos restantes se completarán automáticamente.\",\n    \"old\": \"Su versión actual del servidor está desactualizada. Hemos habilitado el VoceSpace oficial (vocespace.com) como su servicio de audio/video predeterminado. Para usar su propia implementación privada, actualice vocechat-server a la versión 0.5.8 o superior.\"\n  },\n  \"channel\": {\n    \"leave\": \"Abandonar Canal\",\n    \"leave_desc\": \"¿Estás seguro de que deseas abandonar este canal?\",\n    \"transfer_desc\": \"Debes transferir la propiedad de tu canal a otra persona antes de abandonarlo.\",\n    \"delete\": \"Eliminar Canal\",\n    \"delete_desc\": \"¿Estás seguro de que deseas eliminar este canal?\",\n    \"id\": \"ID del Canal\",\n    \"name\": \"Nombre del Canal\",\n    \"topic\": \"Tema del Canal\",\n    \"topic_placeholder\": \"Informa a todos cómo usar este canal.\",\n    \"visibility\": \"Visibilidad del Canal\",\n    \"public\": \"Público\",\n    \"private\": \"Privado\"\n  },\n  \"dm\": {\n    \"delete\": \"Eliminar Usuario\",\n    \"delete_desc\": \"¿Estás seguro de que deseas eliminar a este usuario?\"\n  },\n  \"overview\": {\n    \"title_feat\": \"Funciones\",\n    \"name\": \"Nombre del Servidor\",\n    \"desc\": \"Descripción del Servidor\",\n    \"upload_desc\": \"El tamaño mínimo es 128x128. Recomendamos al menos 512x512 para el servidor. Tamaño máximo limitado a 5M.\",\n    \"sign_up\": {\n      \"title\": \"Registro Predeterminado\",\n      \"desc\": \"Quién puede registrarse en este servidor.\",\n      \"everyone\": \"Todos\",\n      \"invite\": \"Solo Enlace de Invitación\"\n    },\n    \"guest_mode\": {\n      \"title\": \"Modo Invitado\",\n      \"desc\": \"Si está habilitado, los visitantes verán los canales públicos de este servidor.\",\n      \"enable\": \"Habilitar\",\n      \"disable\": \"Desactivado\"\n    },\n    \"url\": {\n      \"title\": \"Actualizar URL Frontend\",\n      \"desc\": \"Actualizar la URL del frontend\"\n    },\n    \"lang\": {\n      \"title\": \"Idiomas\",\n      \"desc\": \"Establecer el idioma del sistema\"\n    },\n    \"theme\": {\n      \"title\": \"Tema\",\n      \"desc\": \"Elige tu tema\",\n      \"auto\": \"Automático\",\n      \"dark\": \"Oscuro\",\n      \"light\": \"Claro\"\n    },\n    \"online_status\": {\n      \"title\": \"Estado en Línea\",\n      \"desc\": \"Si está habilitado, los miembros verán el estado en línea/fuera de línea de los demás.\",\n      \"enable\": \"Habilitar\",\n      \"disable\": \"Deshabilitar\"\n    },\n    \"chat_layout\": {\n      \"title\": \"Diseño del Chat\",\n      \"desc\": \"Dónde mostrar los mensajes enviados por ti mismo\",\n      \"left\": \"Izquierda\",\n      \"self_right\": \"Derecha\"\n    },\n    \"contact_verify\": {\n      \"title\": \"Verificación de Contactos\",\n      \"desc\": \"Por defecto, todos los miembros del servidor pueden ver a los demás. Si quieres que los miembros del servidor añadan y gestionen sus propios contactos, habilita la función de contactos (el administrador estará en la lista de contactos por defecto).\",\n      \"enable\": \"Habilitar\",\n      \"disable\": \"Deshabilitar\"\n    }\n  },\n  \"data\": {\n    \"clear_files\": {\n      \"title\": \"Datos de Archivos e Imágenes\",\n      \"desc\": \"Haz clic en el botón de abajo para eliminar todos los datos de archivos e imágenes de este servidor.\",\n      \"btn\": \"Limpiar Datos de Archivos\"\n    },\n    \"clear_msgs\": {\n      \"title\": \"Todos los Datos de Mensajes\",\n      \"desc\": \"Haz clic en el botón de abajo para eliminar todos los datos de chat, incluidos textos y archivos, de este servidor.\",\n      \"btn\": \"Limpiar Datos de Chats\"\n    },\n    \"auto_delete_file\": {\n      \"title\": \"Autoeliminar Datos de Archivos\",\n      \"desc\": \"Establece el tiempo de caducidad para todos los datos de archivos de este servidor.\",\n      \"confirm_desc\": \"Todos los archivos más antiguos que el tiempo establecido serán eliminados.\",\n      \"off\": \"Desactivado\",\n      \"day1\": \"1 Día\",\n      \"day7\": \"7 Días\",\n      \"day30\": \"30 Días\",\n      \"day90\": \"90 Días\",\n      \"day180\": \"180 Días\"\n    }\n  },\n  \"license\": {\n    \"signed\": \"Firmado\",\n    \"domain\": \"Dominios\",\n    \"user_limit\": \"Límite de Usuarios\",\n    \"expire\": \"Caduca en\",\n    \"create\": \"Creado en\",\n    \"value\": \"Valor de la Licencia\",\n    \"renew\": \"Renovar Licencia\",\n    \"update\": \"Actualizar Manualmente\",\n    \"update_placeholder\": \"Por favor, introduce el nuevo valor de la licencia\",\n    \"renew_select\": \"Por favor, selecciona el precio\",\n    \"tip\": {\n      \"title\": \"¡Oportunidad de obtener una actualización gratuita de la licencia!\",\n      \"user_test\": \"Obtén una actualización gratuita de la licencia a través de una prueba de usuario de 25 minutos\",\n      \"contact\": \"Reserva un horario aquí: \"\n    },\n    \"payment_success\": \"¡Pago Exitoso!\",\n    \"back_home\": \"Volver a Inicio\",\n    \"tip_renewing\": \"¡Renovando la Licencia, no cierres la ventana!\",\n    \"tip_renewed\": \"¡Licencia Renovada Exitosamente!\",\n    \"tip_renew_error\": \"ID de Sesión de Stripe Inválido\",\n    \"tip_domain\": \"La licencia está vinculada al dominio (sin puerto), por favor confirma o actualiza tu configuración:\",\n    \"tip_port\": \"Ingresa tu nombre de dominio sin puerto.\",\n    \"tip_confirm\": \"Iniciar Pago\"\n  },\n  \"bot\": {\n    \"add_api_key\": \"Agregar Clave API\",\n    \"no_api_key\": \"Aún no hay Clave API\",\n    \"bot_tip_title\": \"Los Bots pueden enviar mensajes a canales.\",\n    \"bot_tip_desc\": \"Ten en cuenta que no mostramos nuevamente la clave API de un Bot después de su generación. Siempre puedes generar una nueva clave API de un Bot haciendo clic en 'Agregar Clave API' y esto no anulará las claves API anteriores.\",\n    \"webhook_tip_title\": \"Los Webhooks pueden recibir mensajes en un canal y deben proporcionar una URL proporcionada por ti.\",\n    \"webhook_tip_desc\": \"Proporciona una URL de webhook que devolverá un código de respuesta 200.\",\n    \"manage\": \"Gestionar\",\n    \"how_to_use\": \"Cómo Utilizar\",\n    \"manage_desc\": \"Puedes eliminar un bot en cualquier momento, el usuario del bot se eliminará inmediatamente y todas las APIs se anularán.\",\n    \"create_title\": \"Crear Bot\",\n    \"create_desc\": \"Dale un nombre a tu bot. También puedes agregar una URL de punto final de webhook para recibir datos.\",\n    \"create_key_title\": \"Crear Clave API de Bot\",\n    \"create_key_desc\": \"Crea una Clave API para autenticar tu comunicación\",\n    \"create_key_warning\": \"Asegúrate de copiar la Clave API ahora. ¡No podrás verla nuevamente!\",\n    \"key_copy_and_close\": \"Copiar y Cerrar\",\n    \"delete_title\": \"Eliminar Bot\",\n    \"delete_desc\": \"¿Estás seguro de eliminar el Bot?\",\n    \"delete_key_title\": \"Eliminar Clave API de Bot\",\n    \"delete_key_desc\": \"¿Estás seguro de eliminar esta Clave API de Bot?\",\n    \"webhook_title\": \"Actualizar URL de Webhook\",\n    \"webhook_desc\": \"Por favor ingresa una URL válida\",\n    \"col_avatar\": \"Avatar\",\n    \"col_name\": \"Nombre del Bot\",\n    \"col_api_key\": \"Clave API (Mensajes de Entrada)\",\n    \"col_webhook\": \"URL del Webhook de Extremo (Salida)\",\n    \"col_opt\": \"Operaciones\",\n    \"col_key_name\": \"Nombre\",\n    \"col_key_value\": \"Clave\",\n    \"col_key_create_time\": \"Creado en\",\n    \"col_key_last_used\": \"Último Uso\"\n  },\n  \"auto_delete_msg\": {\n    \"title\": \"Eliminar mensajes enviados por mí después de cierto período de tiempo.\",\n    \"desc\": \"Esto eliminará los datos de mensajes almacenados tanto en el servidor como en el lado del cliente.\",\n    \"off\": \"Desactivado\",\n    \"5_min\": \"5 minutos\",\n    \"10_min\": \"10 minutos\",\n    \"1_hour\": \"1 hora\",\n    \"1_day\": \"1 día\",\n    \"1_week\": \"1 semana\",\n    \"clear\": \"Eliminar todos los mensajes del canal\",\n    \"clear_title\": \"Eliminar todos los mensajes en este canal.\",\n    \"clear_desc\": \"Esto eliminará todos los datos de mensajes almacenados tanto en el servidor como en el lado del cliente.\"\n  },\n  \"firebase\": {\n    \"disable\": \"Desactivar\",\n    \"use_official\": \"Usar Configuración Oficial\",\n    \"custom\": \"Personalizado\",\n    \"enable\": \"Habilitar\",\n    \"token_url\": \"URL del Token\",\n    \"project_id\": \"ID del Proyecto\",\n    \"private_key\": \"Clave Privada\",\n    \"client_email\": \"Correo Electrónico del Cliente\"\n  },\n  \"smtp\": {\n    \"enable\": \"Habilitar\",\n    \"host\": \"Host\",\n    \"port\": \"Puerto\",\n    \"from\": \"Desde\",\n    \"username\": \"Nombre de Usuario\",\n    \"password\": \"Contraseña\",\n    \"how_to\": \"¿Cómo configurar SMTP?\",\n    \"send_test_email\": \"Enviar Correo Electrónico de Prueba\"\n  },\n  \"agora\": {\n    \"enable\": \"Habilitar\",\n    \"how_to\": \"¿Cómo configurar Agora?\"\n  },\n  \"third_app\": {\n    \"key\": \"Clave de Seguridad API\",\n    \"update\": \"Actualizar Secreto\",\n    \"update_tip\": \"¿Estás seguro de actualizar el secreto API? El secreto anterior será invalidado\",\n    \"key_tip\": \"La clave de seguridad acordada entre el servidor y la aplicación de terceros se utiliza para cifrar los datos de comunicación.\",\n    \"how_to\": \"¿Cómo utilizar?\"\n  },\n  \"login\": {\n    \"password\": \"Contraseña\",\n    \"password_desc\": \"Permite a los miembros iniciar sesión con contraseña.\",\n    \"magic_link\": \"Enlace Mágico\",\n    \"magic_link_desc\": \"Permite a los miembros iniciar sesión con Enlace Mágico.\",\n    \"google\": \"Google\",\n    \"google_desc\": \"Permite a los miembros iniciar sesión con Google.\",\n    \"github\": \"GitHub\",\n    \"github_desc\": \"Permite a los miembros iniciar sesión con GitHub.\",\n    \"metamask\": \"Metamask\",\n    \"metamask_desc\": \"Permite a los miembros iniciar sesión con Metamask.\",\n    \"oidc\": \"OIDC\",\n    \"oidc_desc\": \"Permite a los miembros iniciar sesión con OIDC.\",\n    \"oidc_custom\": \"Personalizado\",\n    \"more_details\": \"¿Necesitas más detalles? Consulta nuestra <0>documentación</0>.\"\n  },\n  \"widget\": {\n    \"tip\": \"¡Extiende VoceChat integrando el SDK del widget de VoceChat!\",\n    \"code\": \"Ejemplo de Código\",\n    \"code_comment\": \"inserta este fragmento de código en tu archivo HTML\",\n    \"config\": \"Descripción de Configuración\",\n    \"param_key\": \"Clave del Parámetro\",\n    \"default_value\": \"Valor Predeterminado\",\n    \"remark\": \"Notas\",\n    \"custom_style_tip\": \"si deseas personalizar la posición del widget de manera más precisa, usa el ID del elemento del widget en tu archivo HTML o CSS, como este\",\n    \"param_id\": \"ID del Widget (versión del servidor >= v0.3.12)\",\n    \"param_host\": \"Asigna el usuario que está chateando con el visitante (ID de Usuario)\",\n    \"param_title\": \"chat popup title\",\n    \"param_logo\": \"chat popup logo icon URL\",\n    \"param_auto_reg\": \"true: Registro automático de un nuevo usuario si no existe, false: el visitante debe ingresar correo electrónico y nombre para registrarse\",\n    \"param_login_token\": \"Si estás utilizando la información de usuario existente de tu propia plataforma para generar una nueva cuenta de VoceChat, este es el token de inicio de sesión generado por tu plataforma. Para más detalles, consulta: https://doc.voce.chat/zh-cn/login-with-other-account. ¡No lo llenes para escenarios predeterminados (sin sistema de usuario de terceros)!\",\n    \"param_theme_color\": \"El color del tema del widget\",\n    \"param_close_width\": \"El ancho cuando el widget está cerrado\",\n    \"param_close_height\": \"La altura cuando el widget está cerrado\",\n    \"param_open_width\": \"El ancho cuando el widget está abierto\",\n    \"param_open_height\": \"La altura cuando el widget está abierto\",\n    \"param_welcome\": \"Mensaje de Bienvenida Personalizado\",\n    \"param_position\": \"Posición del Widget: izquierda/derecha\",\n    \"share_link\": \"Comparte el enlace del widget para que las personas puedan chatear contigo directamente\",\n    \"widget_faq\": \"Habilitar Dejar que Todos se Unan Primero\"\n  },\n  \"version\": {\n    \"client_version\": \"Versión del Cliente\",\n    \"server_version\": \"Versión del Servidor\",\n    \"build_time\": \"Marca de Tiempo de Compilación\",\n    \"sync\": \"Sincronizar con la última versión del cliente web\"\n  },\n  \"api_doc\": {\n    \"desc\": \"Tenemos una documentación detallada de la API que puedes utilizar para construir tu propia herramienta de chat.\",\n    \"access\": \"Acceso URL:\",\n    \"use_method\": \"Método de Uso:\",\n    \"step_1\": \"Paso Uno: Cambia a tu propio Servidor\",\n    \"step_2\": \"Paso Dos: Ingresa el token de inicio de sesión\",\n    \"step_2_desc\": \"Puedes obtener el token accediendo al encabezado X-API-Key http o simplemente copiando el texto a continuación:\",\n    \"last\": \"Cada API tiene un botón 'Probar' para que puedas depurar la API con él\"\n  },\n  \"notification\": {\n    \"desc\": \"Configurar preferencias de notificación para diferentes canales\",\n    \"loading\": \"Cargando...\",\n    \"no_channels\": \"No hay canales de notificación disponibles. Póngase en contacto con su administrador para configurar los canales de notificación.\",\n    \"status\": \"Estado\",\n    \"enabled\": \"Habilitado\",\n    \"not_configured\": \"No configurado\",\n    \"configure\": \"Configurar\",\n    \"enable_notifications\": \"Habilitar notificaciones\",\n    \"trigger_conditions\": \"Condiciones de activación\",\n    \"trigger_