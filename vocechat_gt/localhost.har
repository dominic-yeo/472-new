            "text": "{\n  \"login\": {\n    \"title\": \"Iniciar sesión en {{name}}\",\n    \"google\": \"Iniciar sesión con Google\",\n    \"github\": \"Iniciar sesión con GitHub\",\n    \"metamask\": \"Iniciar sesión con MetaMask\",\n    \"password\": \"Iniciar sesión con Contraseña\",\n    \"oidc\": \"Iniciar sesión con OIDC\",\n    \"no_account\": \"¿No tienes una cuenta?\"\n  },\n  \"reg\": {\n    \"title\": \"Regístrate en {{name}}\",\n    \"google\": \"Regístrate con Google\",\n    \"github\": \"Regístrate con GitHub\",\n    \"metamask\": \"Regístrate con MetaMask\",\n    \"oidc\": \"Regístrate con OIDC\",\n    \"have_account\": \"¿Tienes una cuenta?\",\n    \"input_name\": \"¿Cuál es tu nombre?\",\n    \"input_name_tip\": \"Introduce un nombre o alias para que las personas sepan cómo te gustaría que te llamen. Tu nombre solo será visible para otros en los espacios a los que te hayas unido.\"\n  },\n  \"logout\": {\n    \"title\": \"Cerrar sesión\",\n    \"desc\": \"¿Estás seguro de que quieres cerrar sesión en esta cuenta?\",\n    \"clear_local\": \"Borrar datos locales\",\n    \"role_changed\": \"Se detectó un cambio en tu rol, ¿quieres volver a iniciar sesión para aplicar los cambios?\",\n    \"later\": \"Quizás más tarde\"\n  },\n  \"continue\": \"Continuar con correo electrónico\",\n  \"placeholder_name\": \"Introduce tu nombre\",\n  \"placeholder_email\": \"Introduce tu correo electrónico\",\n  \"placeholder_pwd\": \"Introduce una contraseña\",\n  \"placeholder_confirm_pwd\": \"Confirma la contraseña\",\n  \"check_email\": \"Revisa tu bandeja de entrada\",\n  \"check_email_desc\": \"Acabamos de enviar un enlace mágico a <0>{{email}}</0>. Una vez que llegue, será válido por 15 minutos.\",\n  \"back_sign_in\": \"Volver a Iniciar sesión\",\n  \"welcome\": \"Bienvenido al servidor de {{name}}\",\n  \"guest_login_tip\": \"Por favor, escanea el código QR o inicia sesión para enviar un mensaje\",\n  \"enter\": \"Iniciar sesión en \",\n  \"sign_in\": \"Iniciar sesión\",\n  \"sign_up\": \"Registrarse\",\n  \"signing_up\": \"Registrándose\",\n  \"github_login_success\": \"¡Inicio de sesión con GitHub exitoso!\",\n  \"github_logging_in\": \"Iniciando sesión con GitHub...\",\n  \"github_cb_tip\": \"Por favor, cierra esta ventana y vuelve a la ventana del widget\",\n  \"magic_link_expire\": {\n      \"title\": \"Enlace mágico inválido o caducado\",\n      \"desc\": \"Por favor, solicita un nuevo enlace mágico.\",\n      \"desc_close\": \"Puedes cerrar esta ventana ahora.\"\n  },\n  \"invite_mobile\": {\n    \"join\": \"Únete a nuestro servidor\",\n    \"start_download\": \"Comienza descargando la aplicación móvil VoceChat\",\n    \"open\": \"Abre VoceChat\",\n    \"have_already\": \"¿Ya tienes la aplicación??\"\n  },\n  \"invite_expire\": {\n    \"min30\": \"30 minutos\",\n    \"h1\": \"1 hora\",\n    \"h6\": \"6 horas\",\n    \"h12\": \"12 horas\",\n    \"d1\": \"1 día\",\n    \"d7\": \"7 días\",\n    \"d30\": \"30 días\"\n  },\n  \"invite_times\": {\n    \"no_limit\": \"no limit\",\n    \"time1\": \"1 uso\",\n    \"times5\": \"5 usos\",\n    \"times10\": \"10 usos\",\n    \"times25\": \"25 usos\",\n    \"times50\": \"50 usos\",\n    \"times100\": \"100 usos\"\n  }\n}\n"
